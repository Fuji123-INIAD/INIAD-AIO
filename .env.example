# Copy this file to .env for local Docker/VPS use.
# Do not put real secrets in this example file.

POSTGRES_USER=aio_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aio_db

# Used by the FastAPI container to connect to the Compose db service.
DATABASE_URL=postgresql://aio_user:change_me@db:5432/aio_db

# Used by the FastAPI container for the disposable search index.
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=dev-master-key
MEILI_INDEX=search_documents

# Max seconds to wait for AI answer generation before returning a search-result fallback.
ASK_TIMEOUT_SECONDS=20

# Optional until AI response flow is used.
GEMINI_API_KEY=your_gemini_api_key_here
